{
  "name": "hearthfolk",
  "version": "0.0.19",
  "private": true,
  "type": "module",
  "description": "Hearthfolk: an idle skilling game in a living village.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web && node tools/web_page.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.2"
  }
}
